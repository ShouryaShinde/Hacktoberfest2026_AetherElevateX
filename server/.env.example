NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/my_database
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
MAX_EXTRACTED_CHARS=100000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemma Inference Provider Configuration (mock | hosted | local)
GEMMA_PROVIDER=mock
GEMMA_MODEL_ID=gemma-4-9b-it
GEMMA_BASE_URL=https://api.example.com/v1
GEMMA_API_KEY=your_api_key_here
GEMMA_TIMEOUT_MS=60000
GEMMA_MAX_RETRIES=2

